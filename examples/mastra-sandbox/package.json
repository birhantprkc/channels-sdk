{
  "name": "mastra-sandbox-channel",
  "version": "0.1.0",
  "private": true,
  "description": "Mastra workspace and sandbox example for CopilotKit Channels",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@ag-ui/mastra": "1.1.1",
    "@copilotkit/channels": "0.8.1",
    "@copilotkit/runtime": "1.67.1",
    "@mastra/client-js": "1.39.0",
    "@mastra/core": "1.58.0",
    "@valibot/to-json-schema": "1.7.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
